config_version=5

[application]
config/name="InfiniteEgg"
run/main_scene="res://scenes/road_showcase.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
rendering_device/fallback_to_vulkan=true
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.24, 0.16, 0.10, 1)
